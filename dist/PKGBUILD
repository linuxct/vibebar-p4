# Maintainer: p4block <https://github.com/p4block>
pkgname=vibebar-p4-git
_pkgname=vibebar-p4
pkgver=2026.6.9.gb7d9a74
pkgrel=1
pkgdesc="A purely vibe-coded status bar for personal use, built with Rust and GTK4."
arch=('x86_64')
url="https://github.com/linuxct/vibebar-p4"
license=('WTFPL')
depends=('gtk4' 'gtk4-layer-shell' 'libpulse' 'dbus')
makedepends=('cargo' 'git' 'pkgconf')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+https://github.com/linuxct/vibebar-p4.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local ver=$(git log -1 --format="%cd.g%h" --date=format:"%Y.%-m.%-d")
  echo "$ver"
}

prepare() {
  cd "$_pkgname"
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --all-features
}

package() {
  cd "$_pkgname"
  install -Dm755 "target/release/$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  # install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
